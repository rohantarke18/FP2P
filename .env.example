# GEMINI_API_KEY: Required for Gemini AI API calls (Free tier).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon PostgreSQL connection string (e.g. postgresql://neondb_owner:***@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# SESSION_SECRET: High-entropy secret key for signing HTTP-only session cookies
SESSION_SECRET=

# SUPER_ADMIN_EMAILS: Optional comma-separated list of designated initial super administrator emails
SUPER_ADMIN_EMAILS=

